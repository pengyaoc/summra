# Systemd service for Summra on e2-small (WITH TTS)
# Place in /etc/systemd/system/summra.service

[Unit]
Description=Summra Book Summary Application (with TTS)
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/summra
Environment="PATH=/var/www/summra/venv/bin"
Environment="PYTHONPATH=/var/www/summra"
Environment="GUNICORN_WORKERS=2"

# Load environment variables (including GEMINI_API_KEY)
EnvironmentFile=/var/www/summra/.env

# Start Gunicorn
ExecStart=/var/www/summra/venv/bin/gunicorn \
    -c deploy/gunicorn_config_e2small.py \
    backend.app:app

# Restart policy
Restart=on-failure
RestartSec=10s

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (e2-small has 2GB RAM)
# Allow up to 1.5GB for the app, leave 500MB for system
MemoryMax=1536M
MemoryHigh=1280M

# CPU limit (don't starve system)
CPUQuota=150%

[Install]
WantedBy=multi-user.target
