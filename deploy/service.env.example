# Summra's systemd EnvironmentFile.
#
# Installed by deploy/install.sh to /opt/summra/service.env, mode 600,
# owned summra:summra. This is the ONE file that differs per deployment —
# everything else in deploy/ is committed and identical across hosts.
#
# No GEMINI_API_KEY here on purpose: production (app_prod.py) never
# generates TTS, it only serves pre-generated audio from the cache, so the
# key is never needed on a deployed box. All Gemini calls happen locally
# during content generation; only their output (audio files, DB rows)
# ships to the server. Keep the real key in your local (untracked) .env
# for local dev / content generation only.

# Standalone default is 127.0.0.1:5000 (deploy/gunicorn_config.py's
# fallback). Set this only when cohosting on a port another service isn't
# already using — see the port registry in
# 01-projects/personal-brand/vm-service-convention.md.
# GUNICORN_BIND=127.0.0.1:5001

GUNICORN_WORKERS=1
GUNICORN_THREADS=4

PYTHONPATH=/opt/summra
PATH=/opt/summra/venv/bin

FLASK_ENV=production
