# Systemd service for Summra
# Place in /etc/systemd/system/summra.service

[Unit]
Description=Summra Book Summary Application
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/summra
Environment="PATH=/var/www/summra/venv/bin"
Environment="PYTHONPATH=/var/www/summra"
Environment="GUNICORN_WORKERS=1"

# Load environment variables (including GEMINI_API_KEY)
EnvironmentFile=/var/www/summra/.env

# Start Gunicorn
ExecStart=/var/www/summra/venv/bin/gunicorn \
    -c deploy/gunicorn_config.py \
    backend.app_prod:app

# Restart policy
Restart=on-failure
RestartSec=5s

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits (important for e2-micro!)
MemoryMax=400M
MemoryHigh=350M

[Install]
WantedBy=multi-user.target
