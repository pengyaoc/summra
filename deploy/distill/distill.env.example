# Distill's systemd EnvironmentFile: /opt/summra/distill.env, mode 600,
# owned summra:summra. VM-only; never commit the real file.

# Port registry: 5001 is Plainly, 5002 is Distill.
GUNICORN_BIND=127.0.0.1:5002
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
# Both apps run gunicorn from one config; give each its own name and pidfile.
GUNICORN_PROC_NAME=distill
GUNICORN_PIDFILE=/tmp/distill-gunicorn.pid

PYTHONPATH=/opt/summra
PATH=/opt/summra/venv/bin

# Absolute paths: a wrong DISTILL_DB silently creates an empty library.
DISTILL_DB=/opt/summra/data/distill.db
DISTILL_USER_DB=/opt/summra/data/distill_user.db

# Owner-only. distill.app_prod refuses to start unless the mode is required.
DISTILL_AUTH_MODE=required
DISTILL_ALLOWED_EMAILS=you@example.com
