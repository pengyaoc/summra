# Settings for `python -m distill.scripts.deploy_db` and `push_book --deploy`.
# Copy to deploy/distill/deploy.local.env (gitignored) and fill in the real values.
DISTILL_VM_INSTANCE=your-vm-instance
DISTILL_VM_ZONE=your-zone
DISTILL_VM_PROJECT=your-gcp-project
DISTILL_VM_ACCOUNT=you@example.com
DISTILL_VM_SERVICE_USER=service-user
DISTILL_VM_REMOTE_DB=/opt/app/data/distill.db
DISTILL_VM_UNIT=distill.service
# Distill's local gunicorn port on the VM (the post-deploy 401 check hits it).
DISTILL_VM_PORT=5002
DISTILL_SITE_URL=https://pengyaochen.com/distill

# Optional overrides; defaults are derived from DISTILL_VM_REMOTE_DB.
# DISTILL_VM_MEDIA_DIR=/opt/app/data/distill-media
# DISTILL_VM_REPO_ROOT=/opt/app

# Chapter audio (make_audio, run on the Mac): InkChinese Siri exporter and its venv
DISTILL_SIRI_TTS_PATH=../inkchinese/pipeline
DISTILL_SIRI_PYTHON=../inkchinese/pipeline/.venv/bin/python
# Set both so deploy_code also restarts Plainly when a change affects it.
# DISTILL_VM_PLAINLY_UNIT
# DISTILL_VM_PLAINLY_PORT
